# Copy this file to .env and replace the placeholder values.
# Do not commit .env: it contains local credentials.
DATABASE_URL=postgresql+psycopg://ticket_stampede:replace-with-a-strong-password@127.0.0.1:5432/ticket_stampede

# The connectivity test uses this value when set. It may point to the same
# local development database because the current check is read-only.
TEST_DATABASE_URL=postgresql+psycopg://ticket_stampede:replace-with-a-strong-password@127.0.0.1:5432/ticket_stampede

